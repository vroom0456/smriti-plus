# ==============================================
# SMRITI+ — Environment Configuration Template
# ==============================================

# Application
SMRITI_APP_NAME="SMRITI+"
SMRITI_APP_VERSION="1.0.0"
SMRITI_DEBUG=true

# Database (PostgreSQL default or SQLite for local offline testing)
# PostgreSQL production/staging:
SMRITI_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smriti_plus"
# SQLite local alternative:
# SMRITI_DATABASE_URL="sqlite:///./smriti_local.db"

# JWT Authentication
SMRITI_SECRET_KEY="smriti-plus-dev-secret-key-change-in-production-before-deployment"
SMRITI_ALGORITHM="HS256"
SMRITI_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo / Development Mode
SMRITI_DEMO_OTP="123456"
